# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Both are safe to expose in a
# client app — they're the public client keys, not secrets.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
